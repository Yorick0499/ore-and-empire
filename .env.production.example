# Copy to .env.production, chmod 600; generate private values before deployment.
ORE_ENV=production
DEBUG=False
SECRET_KEY=
ORE_DOMAIN=gra.example.test
ALLOWED_HOSTS=gra.example.test
CSRF_TRUSTED_ORIGINS=https://gra.example.test
ORE_DATABASE_ENGINE=postgresql
PGHOST=db
PGPORT=5432
PGDATABASE=ore_world
PGUSER=ore_app
PGPASSWORD=
# PostgreSQL is inside the private Compose network; hosted DBs should verify TLS.
PGSSLMODE=disable
ORE_TRUSTED_PROXY_CIDRS=172.30.24.2/32
ORE_FORWARDED_ALLOW_IPS=172.30.24.2
ORE_BIND=0.0.0.0:8080
ORE_LISTEN_ADDRESS=127.0.0.1
ORE_HTTP_PORT=8088
ORE_HTTPS_PORT=8448
