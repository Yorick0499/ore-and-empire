[Unit]
Description=Ore and Empire - worker swiata
After=network-online.target
Wants=network-online.target
[Service]
User=ore
WorkingDirectory=/opt/ore/current
EnvironmentFile=/etc/ore/production.env
ExecStart=/opt/ore/venv/bin/python manage.py run_worker
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
